# Yalnız anahtar adları. Değerleri .env dosyasına yaz; .env repoya girmez.
SECRET_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Neon ya da başka Postgres. Örnek biçim: postgresql://kullanici:parola@sunucu/vt?sslmode=require
DATABASE_URL=
# 1 olursa Gemini yerine sabit, yerel örnek analiz döner (anahtarsız deneme için).
AI_FAKE=
# Boşsa memory:// (süreç başına). Birden çok worker için paylaşımlı depo, ör. redis://...
RATELIMIT_STORAGE_URI=
FLASK_DEBUG=
